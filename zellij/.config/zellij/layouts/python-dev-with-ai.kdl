layout {
    // 1. Define the UI chrome once
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children // Your actual tab content gets injected here
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    // 2. Define your specific tabs
    tab name="code" focus=true hide_floating_panes=true {
        pane command="/usr/bin/nvim" focus=true
    }
    
    tab name="run" hide_floating_panes=true {
        pane
    } 
	tab name="AI" hide_floating_panes=true {
        pane command="zsh" {
            args "-c" "source ~/.zshrc; opencode_launcher"
        }
    }
    tab name="git" hide_floating_panes=true {
        pane
    }
}
